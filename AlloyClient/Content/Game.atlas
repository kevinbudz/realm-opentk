<Atlas source="Sheets">

    <!-- ═══════════════════════════════════════════════════════════
         STATIC IMAGE SETS  (AssetLibrary.addImageSet)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Core UI / Misc -->
    <Image name="cursors"          w="32" h="32">Cursors.png</Image>
    <Image name="tileAlphaBlend"   w="8"  h="8" >AlphaTileBlends.png</Image>
    <Image name="invisible"        w="8"  h="8" >invisible.png</Image>
    <Image name="redLootBag"       w="8"  h="8" >RedLootBag.png</Image>
    <Image name="stars"            w="5"  h="5" >Stars.png</Image>

    <!-- Blend / Mask tiles -->
    <Image name="inner_mask"       w="4"  h="4" >InnerMask.png</Image>
    <Image name="sides_mask"       w="4"  h="4" >SidesMask.png</Image>
    <Image name="outer_mask"       w="4"  h="4" >OuterMask.png</Image>
    <Image name="innerP1_mask"     w="4"  h="4" >InnerP1Mask.png</Image>
    <Image name="innerP2_mask"     w="4"  h="4" >InnerP2Mask.png</Image>

    <!-- Textiles -->
    <Image name="textile4x4"       w="4"  h="4" >Textile4x4.png</Image>
    <Image name="textile5x5"       w="5"  h="5" >Textile5x5.png</Image>
    <Image name="textile9x9"       w="9"  h="9" >Textile9x9.png</Image>
    <Image name="textile10x10"     w="10" h="10">Textile10x10.png</Image>

    <!-- Lofi Character sheets (one PNG, multiple cell sizes) -->
    <Image name="lofiChar8x8"      w="8"  h="8" >LofiChar.png</Image>
    <Image name="lofiChar16x8"     w="16" h="8" >LofiChar.png</Image>
    <Image name="lofiChar16x16"    w="16" h="16">LofiChar.png</Image>
    <Image name="lofiChar28x8"     w="8"  h="8" >LofiChar2.png</Image>
    <Image name="lofiChar216x8"    w="16" h="8" >LofiChar2.png</Image>
    <Image name="lofiChar216x16"   w="16" h="16">LofiChar2.png</Image>
    <Image name="lofiCharBig"      w="16" h="16">LofiCharBig.png</Image>

    <!-- Lofi Environment -->
    <Image name="lofiEnvironment"  w="8"  h="8" >LofiEnvironment.png</Image>
    <Image name="lofiEnvironment2" w="8"  h="8" >LofiEnvironment2.png</Image>
    <Image name="lofiEnvironment3" w="8"  h="8" >LofiEnvironment3.png</Image>

    <!-- Lofi Interface -->
    <Image name="lofiInterface"    w="8"  h="8" >LofiInterface.png</Image>
    <Image name="lofiInterface2"   w="8"  h="8" >LofiInterface2.png</Image>
    <Image name="lofiInterfaceBig" w="16" h="16">LofiInterfaceBig.png</Image>

    <!-- Lofi Objects -->
    <Image name="lofiObj"          w="8"  h="8" >LofiObj.png</Image>
    <Image name="lofiObj2"         w="8"  h="8" >LofiObj2.png</Image>
    <Image name="lofiObj3"         w="8"  h="8" >LofiObj3.png</Image>
    <Image name="lofiObj4"         w="8"  h="8" >LofiObj4.png</Image>
    <Image name="lofiObj5"         w="8"  h="8" >LofiObj5.png</Image>
    <Image name="lofiObj6"         w="8"  h="8" >LofiObj6.png</Image>
    <Image name="lofiObjBig"       w="16" h="16">LofiObjBig.png</Image>
    <Image name="lofiObj40x40"     w="40" h="40">LofiObj40x40.png</Image>

    <!-- Lofi Projectiles & Parts -->
    <Image name="lofiProjs"        w="8"  h="8" >LofiProjs.png</Image>
    <Image name="lofiProjsBig"     w="16" h="16">LofiProjsBig.png</Image>
    <Image name="lofiParts"        w="8"  h="8" >LofiParts.png</Image>

    <!-- ═══════════════════════════════════════════════════════════
         ANIMATED CHARACTER SETS  (AnimatedChars.add)
         group="Full" = sheetHeight is 3× charHeight (3-row player-style sheets)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Core encounter / world character sheets -->
    <Animated name="chars8x8rBeach"          w="8"  h="8" >Chars8x8rBeach.png</Animated>
    <Animated name="chars8x8dBeach"          w="8"  h="8" >Chars8x8dBeach.png</Animated>
    <Animated name="chars8x8rLow1"           w="8"  h="8" >Chars8x8rLow1.png</Animated>
    <Animated name="chars8x8rLow2"           w="8"  h="8" >Chars8x8rLow2.png</Animated>
    <Animated name="chars8x8rMid"            w="8"  h="8" >Chars8x8rMid.png</Animated>
    <Animated name="chars8x8rMid2"           w="8"  h="8" >Chars8x8rMid2.png</Animated>
    <Animated name="chars8x8rHigh"           w="8"  h="8" >Chars8x8rHigh.png</Animated>
    <Animated name="chars8x8rHero1"          w="8"  h="8" >Chars8x8rHero1.png</Animated>
    <Animated name="chars8x8rHero2"          w="8"  h="8" >Chars8x8rHero2.png</Animated>
    <Animated name="chars8x8dHero1"          w="8"  h="8" >Chars8x8dHero1.png</Animated>
    <Animated name="chars16x16dMountains1"   w="16" h="16">Chars16x16dMountains1.png</Animated>
    <Animated name="chars16x16dMountains2"   w="16" h="16">Chars16x16dMountains2.png</Animated>
    <Animated name="chars8x8dEncounters"     w="8"  h="8" >Chars8x8dEncounters.png</Animated>
    <Animated name="chars8x8rEncounters"     w="8"  h="8" >Chars8x8rEncounters.png</Animated>
    <Animated name="chars16x8dEncounters"    w="16" h="8" >Chars16x8dEncounters.png</Animated>
    <Animated name="chars16x8rEncounters"    w="16" h="8" >Chars16x8rEncounters.png</Animated>
    <Animated name="chars16x16dEncounters"   w="16" h="16">Chars16x16dEncounters.png</Animated>
    <Animated name="chars16x16dEncounters2"  w="16" h="16">Chars16x16dEncounters2.png</Animated>
    <Animated name="chars16x16rEncounters"   w="16" h="16">Chars16x16rEncounters.png</Animated>

    <!-- Player classes and selectable skins (group="Full" = 3-row sheet: walk/attack/default) -->
    <Animated name="players"                 w="8"  h="8"  group="Full">Players.png</Animated>
    <Animated name="playerskins"             w="8"  h="8"  group="Full">PlayersSkins.png</Animated>

    <!-- Pets -->
    <Animated name="chars8x8rPets1"          w="8"  h="8" >Chars8x8rPets1.png</Animated>

</Atlas>
